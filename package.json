{
  "name": "agentrelay",
  "version": "1.0.0",
  "private": true,
  "description": "A policy-enforced multi-agent workflow and human-approval platform built on Codex CLI.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"node --env-file=.env --import tsx --watch apps/server/src/index.ts\" \"npm run dev -w @launchpad/web\"",
    "build": "npm run build -w @launchpad/web && npm run build -w @launchpad/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "docs:check-links": "remark README.md SECURITY.md docs --frail --use remark-validate-links",
    "check": "npm run typecheck && npm run test && npm run build",
    "poc": "./scripts/start-local-poc.sh",
    "seed:agentrelay-demo": "npm run seed:agentrelay-demo -w @launchpad/server",
    "reset:agentrelay-demo": "npm run reset:agentrelay-demo -w @launchpad/server",
    "start": "npm run start -w @launchpad/server"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.2.1",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.0.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
